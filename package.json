{
  "name": "link-rot",
  "version": "0.1.0",
  "description": "Find dead external links, broken relative paths, and stale in-page anchors in Markdown and docs.",
  "keywords": [
    "link-checker",
    "markdown",
    "documentation",
    "dead-links",
    "cli",
    "github-actions",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "anthill24",
  "homepage": "https://github.com/anthill24/link-rot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthill24/link-rot.git"
  },
  "bugs": {
    "url": "https://github.com/anthill24/link-rot/issues"
  },
  "type": "module",
  "bin": {
    "link-rot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "picomatch": "^4.0.2",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.10",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.17.0",
    "@types/picomatch": "^3.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
